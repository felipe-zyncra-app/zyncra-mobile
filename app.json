{
  "expo": {
    "name": "Zyncra",
    "slug": "zyncra-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "zyncra",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zyncra.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zyncra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#07071a"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#fb0f05",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zyncra necesita acceso a tus fotos para que puedas subir la foto de tu negocio o de tu equipo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8629d2ca-d800-438b-ad2f-583c7f7bf977"
      }
    },
    "owner": "soypipecontreras"
  }
}
