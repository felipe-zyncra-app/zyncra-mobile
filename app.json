{
  "expo": {
    "name": "Zyncra",
    "slug": "zyncra-mobile",
    "version": "1.2.4",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8629d2ca-d800-438b-ad2f-583c7f7bf977"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "zyncra",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zyncra.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.zyncra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#07071a"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#111118",
          "dark": {
            "image": "./assets/splash-logo.png",
            "backgroundColor": "#111118"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#fb0f05",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zyncra necesita acceso a tus fotos para que puedas subir la foto de tu negocio o de tu equipo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8629d2ca-d800-438b-ad2f-583c7f7bf977"
      }
    },
    "owner": "soypipecontreras"
  }
}
